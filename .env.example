RACEVAULT_POSTGRES_DB=racevault
RACEVAULT_POSTGRES_USER=racevault
RACEVAULT_POSTGRES_PASSWORD=racevault-local-only
RACEVAULT_POSTGRES_HOST=postgres
RACEVAULT_POSTGRES_PORT=5432
RACEVAULT_OPENSEARCH_URL=http://opensearch:9200
RACEVAULT_OPENSEARCH_INDEX_NAME=racevault-chunks-v2
RACEVAULT_OPENSEARCH_TIMEOUT_SECONDS=10.0
RACEVAULT_SEMANTIC_MODEL_ID=BAAI/bge-m3
RACEVAULT_SEMANTIC_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RACEVAULT_SEMANTIC_MAX_TOKENS=8192
RACEVAULT_SEMANTIC_BATCH_SIZE=8
RACEVAULT_RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RACEVAULT_RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RACEVAULT_RERANKER_MAX_TOKENS=8192
RACEVAULT_RERANKER_BATCH_SIZE=8
RACEVAULT_API_MODEL_DEVICE=auto
RACEVAULT_API_LOCAL_FILES_ONLY=false
RACEVAULT_API_CORS_ORIGINS=["http://localhost:3000"]
RACEVAULT_API_INGESTION_ENABLED=false
# 127.0.0.1, not localhost: localhost resolves to ::1 first on Windows
# and Ollama listens on IPv4 only, so each connection waits ~2s to fail
# over. Irrelevant inside compose, which uses host.docker.internal.
RACEVAULT_OLLAMA_URL=http://127.0.0.1:11434
RACEVAULT_OLLAMA_MODEL=qwen3.5:9b
RACEVAULT_OLLAMA_TIMEOUT_SECONDS=300.0
RACEVAULT_OLLAMA_CONTEXT_TOKENS=16384
RACEVAULT_OLLAMA_MAX_OUTPUT_TOKENS=3072
RACEVAULT_OLLAMA_KEEP_ALIVE=5m
RACEVAULT_ANSWER_RETRIEVAL_CANDIDATE_LIMIT=20
RACEVAULT_ANSWER_FACET_CANDIDATE_LIMIT=8
RACEVAULT_ANSWER_MAX_QUERY_FACETS=6
RACEVAULT_ANSWER_EVIDENCE_LIMIT=8
RACEVAULT_ANSWER_MAX_EVIDENCE_LIMIT=10
RACEVAULT_ANSWER_EVIDENCE_CHARACTER_BUDGET=24000
RACEVAULT_ANSWER_EVIDENCE_TOPIC_WEIGHT=0.15
RACEVAULT_ANSWER_EVIDENCE_DIVERSITY_WEIGHT=0.2
RACEVAULT_ANSWER_EVIDENCE_DUPLICATE_THRESHOLD=0.9
RACEVAULT_ANSWER_EVIDENCE_MAX_PER_SOURCE=3
# Calibrated on the development split of racevault-corpus-v2 only; frozen
# before held-out use. See .artifacts/evaluation/sufficiency-calibration.json.
RACEVAULT_ANSWER_MINIMUM_RERANKER_SCORE=0.2377
RACEVAULT_ANSWER_RELEASE_RETRIEVAL_MODELS=false
RACEVAULT_GENERATION_MAX_CONCURRENCY=1
RACEVAULT_GENERATION_QUEUE_DEPTH=4
RACEVAULT_GENERATION_RETRY_AFTER_SECONDS=5
RACEVAULT_METRICS_ENABLED=true
RACEVAULT_JSON_LOGGING=false
# Set by compose.observability.yaml when OTLP export is enabled.
RACEVAULT_OTEL_EXPORTER_ENDPOINT=
RACEVAULT_OTEL_SERVICE_NAME=racevault-api
RACEVAULT_CORPUS_MANIFEST_PATH=corpus/full_documents.json
RACEVAULT_CORPUS_ROOT_PATH=AI & ML Reference File Database
RACEVAULT_EXTRACTION_ROOT_PATH=.artifacts/extracted
RACEVAULT_CHUNK_ROOT_PATH=.artifacts/chunks
RACEVAULT_UPLOAD_ROOT_PATH=.artifacts/uploads
RACEVAULT_UPLOAD_MAX_BYTES=262144000
RACEVAULT_INGESTION_EXTRACTION_DEVICE=auto
RACEVAULT_INGESTION_THREADS=8
RACEVAULT_INGESTION_REPORT_PATH=.artifacts/reports/full-ingestion.json
RACEVAULT_DEPENDENCY_TIMEOUT_SECONDS=2.0
NEXT_PUBLIC_RACEVAULT_API_URL=http://localhost:8000
